     <%= submit_tag l(:button_add) %>
diff --git a/app/views/groups/_users.html.erb b/app/views/groups/_users.html.erb
index 19aaab094a..92c04731fb 100644
--- a/app/views/groups/_users.html.erb
+++ b/app/views/groups/_users.html.erb
@@ -1,22 +1,30 @@
-<p><%= link_to sprite_icon('add', l(:label_user_new)), new_group_users_path(@group), :remote => true, :class => "icon icon-add" %></p>
+<% users, user_pages, user_count = paginate_group_users(@group) %>
+<p><%= link_to sprite_icon('add', l(:label_user_new)), new_group_users_path(@group, :users_page => params[:users_page]), :remote => true, :class => "icon icon-add" %></p>
 
-<% if @group.users.any? %>
+<% if user_count > 0 %>
+  <div class="autoscroll">
   <table class="list users">
     <thead><tr>
       <th><%= l(:label_user) %></th>
       <th style="width:15%"></th>
     </tr></thead>
     <tbody>
-    <% @group.users.sort.each do |user| %>
+    <% users.each do |user| %>
       <tr id="user-<%= user.id %>">
         <td class="name"><%= link_to_user user %></td>
         <td class="buttons">
-          <%= link_to sprite_icon('link-break', l(:button_remove)), group_users_path(@group, :user_id => user), :method => :delete, :class => 'icon icon-link-break' %>
+          <%= link_to sprite_icon('link-break', l(:button_remove)), group_users_path(@group, :user_id => user, :users_page => params[:users_page]), :method => :delete, :class => 'icon icon-link-break' %>
         </td>
       </tr>
     <% end %>
     </tbody>
   </table>
+  </div>
+  <span class="pagination">
+    <%= pagination_links_full(user_pages, user_count) do |text, parameters, options|
+          link_to text, edit_group_path(@group, request.query_parameters.merge(parameters).merge(:tab => 'users')), options
+        end %>
+  </span>
 <% else %>
   <p class="nodata"><%= l(:label_no_data) %></p>
 <% end %>
diff --git a/test/functional/groups_controller_test.rb b/test/functional/groups_controller_test.rb
index 8c012ffea6..f9e04523c7 100644
--- a/test/functional/groups_controller_test.rb
+++ b/test/functional/groups_controller_test.rb
@@ -169,6 +169,50 @@ class GroupsControllerTest < Redmine::ControllerTest
     assert_select 'div#tab-content-memberships a.icon-link-break', :text => 'Remove'
   end
 
+  def test_edit_users_tab_should_be_paginated
+    group = Group.generate!
+    3.times { group.users << User.generate! }
+
+    with_settings :per_page_options => '2,25,50' do
+      get(:edit, :params => {:id => group.id, :tab => 'users'})
+      assert_response :success
+      assert_select 'div#tab-content-users table.users tbody tr', :count => 2
+      assert_select 'div#tab-content-users span.pagination'
+      assert_select 'div#tab-content-users span.pagination a[href*=?]', 'users_page='
+
+      get(:edit, :params => {:id => group.id, :tab => 'users', :users_page => 2})
+      assert_response :success
+      assert_select 'div#tab-content-users table.users tbody tr', :count => 1
+    end
+  end
+
+  def test_edit_users_tab_with_out_of_range_page_should_keep_pagination
+    group = Group.generate!
+    3.times { group.users << User.generate! }
+
+    with_settings :per_page_options => '2,25,50' do
+      get(:edit, :params => {:id => group.id, :tab => 'users', :users_page => 99})
+    end
+    assert_response :success
+    assert_select 'div#tab-content-users p.nodata', :count => 0
+    assert_select 'div#tab-content-users table.users'
+    assert_select 'div#tab-content-users span.pagination a[href*=?]', 'users_page='
+  end
+
+  def test_edit_users_tab_without_users_should_show_no_data
+    group = Group.generate!
+    get(:edit, :params => {:id => group.id, :tab => 'users'})
+    assert_response :success
+    assert_select 'div#tab-content-users p.nodata'
+    assert_select 'div#tab-content-users table.users', :count => 0
+  end
+
+  def test_new_users_xhr_should_keep_current_page_in_form_action
+    get(:new_users, :params => {:id => 10, :users_page => 2}, :xhr => true)
+    assert_response :success
+    assert_match %r{/groups/10/users\?users_page=2}, response.body
+  end
+
   def test_update
     new_name = 'New name'
     put(
diff --git a/test/helpers/groups_helper_test.rb b/test/helpers/groups_helper_test.rb
index 998c5c2956..8e648da5f8 100644
--- a/test/helpers/groups_helper_test.rb
+++ b/test/helpers/groups_helper_test.rb
@@ -39,4 +39,17 @@ class GroupsHelperTest < Redmine::HelperTest
     assert_select_in result, 'span.pagination li.current span', :text => '1'
     assert_select_in result, 'a[href=?]', "/groups/#{group.id}/autocomplete_for_user.js?page=2", :text => '2'
   end
+
+  def test_paginate_group_users_returns_only_the_requested_page
+    # per_page_option is provided by ApplicationController in the running app
+    stubs(:per_page_option).returns(2)
+    group = Group.generate!
+    3.times { group.users << User.generate! }
+
+    users, user_pages, user_count = paginate_group_users(group)
+
+    assert_equal 2, users.size
+    assert_equal 2, user_pages.per_page
+    assert_equal group.users.count, user_count
+  end
 end
