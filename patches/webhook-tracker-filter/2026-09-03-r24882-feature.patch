+    <fieldset class="box" id="webhook_tracker_ids"><legend><%= toggle_checkboxes_link("#webhook_tracker_ids input[type=checkbox]") %><%= l(:label_tracker_plural) %></legend>
+      <% tracker_ids = @webhook.tracker_ids.to_a %>
