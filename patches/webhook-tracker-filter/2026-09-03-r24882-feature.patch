+        <label><%= check_box_tag('webhook[tracker_ids][]', tracker.id, tracker_ids.include?(tracker.id), :id => nil) %> <%= tracker.name %></label>
+      <% end %>
+      <%= hidden_field_tag('webhook[tracker_ids][]', '', :id => nil) %>
+      <em class="info"><%= l :webhook_trackers_info %></em>
+    </fieldset>
   </div>
 </div>
