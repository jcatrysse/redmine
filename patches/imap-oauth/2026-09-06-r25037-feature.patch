+
+  def test_access_token_should_raise_when_the_response_holds_no_token
+    expect_token_request(response(Net::HTTPOK, '200', 'OK', {'expires_in' => 3599}.to_json))
+
+    with_credentials(CREDENTIALS) do |file|
