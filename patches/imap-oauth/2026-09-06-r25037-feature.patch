+  def test_access_token_should_raise_when_a_successful_response_has_no_json_body
+    expect_token_request(response(Net::HTTPOK, '200', 'OK', '<html>proxy interception page</html>'))
+
+    with_credentials(CREDENTIALS) do |file|
