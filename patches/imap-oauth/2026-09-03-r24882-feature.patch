From: Jan Catrysse <jan.catrysse@geoxyz.eu>
Date: Thu, 3 Sep 2026 11:51:09 +0000
Subject: [PATCH] Authenticate IMAP inbound mail with an OAuth 2.0 access token
 (#43023).

---
 lib/redmine/imap.rb                         |  16 ++-
 lib/redmine/oauth2_client.rb                |  92 +++++++++++++
 lib/tasks/email.rake                        |  22 +++
 test/unit/lib/redmine/imap_test.rb          |  78 +++++++++++
 test/unit/lib/redmine/oauth2_client_test.rb | 144 ++++++++++++++++++++
 5 files changed, 351 insertions(+), 1 deletion(-)
 create mode 100644 lib/redmine/oauth2_client.rb
 create mode 100644 test/unit/lib/redmine/imap_test.rb
 create mode 100644 test/unit/lib/redmine/oauth2_client_test.rb

diff --git a/lib/redmine/imap.rb b/lib/redmine/imap.rb
index 77b8da80f..b94d95694 100644
--- a/lib/redmine/imap.rb
+++ b/lib/redmine/imap.rb
@@ -41,7 +41,13 @@ module Redmine
         if starttls
           imap.starttls
         end
-        imap.login(imap_options[:username], imap_options[:password]) unless imap_options[:username].nil?
+        unless imap_options[:username].nil?
+          if (access_token = oauth2_access_token(imap_options))
+            imap.authenticate('XOAUTH2', imap_options[:username], access_token)
+          else
+            imap.login(imap_options[:username], imap_options[:password])
+          end
+        end
         imap.select(folder)
         imap.uid_search(['NOT', 'SEEN']).each do |uid|
           msg = imap.uid_fetch(uid, 'RFC822')[0].attr['RFC822']
@@ -68,6 +74,14 @@ module Redmine
 
       private
 
+      def oauth2_access_token(imap_options)
+        if imap_options[:oauth2_token].present?
+          imap_options[:oauth2_token]
+        elsif imap_options[:oauth2_credentials].present?
+          Oauth2Client.access_token(imap_options[:oauth2_credentials])
+        end
+      end
+
       def logger
         ::Rails.logger
       end
diff --git a/lib/redmine/oauth2_client.rb b/lib/redmine/oauth2_client.rb
new file mode 100644
index 000000000..e4c7748c2
--- /dev/null
+++ b/lib/redmine/oauth2_client.rb
@@ -0,0 +1,92 @@
+# frozen_string_literal: true
+
+# Redmine - project management software
+# Copyright (C) 2006-  Jean-Philippe Lang
