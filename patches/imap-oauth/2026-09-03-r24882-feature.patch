new file mode 100644
index 000000000..2b09001da
--- /dev/null
+++ b/test/unit/lib/redmine/imap_test.rb
@@ -0,0 +1,78 @@
+# frozen_string_literal: true
+
+# Redmine - project management software
+# Copyright (C) 2006-  Jean-Philippe Lang
+#
