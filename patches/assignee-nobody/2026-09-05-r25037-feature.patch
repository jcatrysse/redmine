+  def test_group_filter_with_a_nobody_value_should_stay_correlated
+    q = UserQuery.new name: '_'
+    q.add_filter('is_member_of_group', '=', ['none', '10'])
+    users = find_users_with_query q
+    assert_equal [8], users.map(&:id)
