diff --git a/lib/redmine/scm/adapters/git_adapter.rb b/lib/redmine/scm/adapters/git_adapter.rb
index d13f06834..4967625e0 100644
--- a/lib/redmine/scm/adapters/git_adapter.rb
+++ b/lib/redmine/scm/adapters/git_adapter.rb
@@ -94,6 +94,25 @@ module Redmine
           nil
         end
 
+        def branches_containing(identifier)
+          return [] if identifier.blank?
+
+          names = []
+          cmd_args = ['branch', '--no-color', '--contains', identifier.to_s]
+          git_cmd(cmd_args) do |io|
+            io.each_line do |line|
+              name = line[2..].to_s.strip
+              next if name.blank? || name.start_with?('(')
+
+              name = scm_iconv('UTF-8', @path_encoding, name)
+              names << name if name
+            end
+          end
+          names.sort!
+        rescue ScmCommandAborted
+          []
+        end
+
         def tags
           return @tags if @tags
 
diff --git a/test/functional/issues_controller_test.rb b/test/functional/issues_controller_test.rb
