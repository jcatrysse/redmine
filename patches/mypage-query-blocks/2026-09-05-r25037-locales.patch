From 72609af8058e50590a1969139d8fff142ec867af Mon Sep 17 00:00:00 2001
From: Jan Catrysse <jan.catrysse@geoxyz.eu>
Date: Thu, 3 Sep 2026 07:25:58 +0000
Subject: [PATCH] Make the maximum number of custom query blocks on My page
 configurable (#27313).

:max_occurs may now name a setting instead of holding an integer, and
Redmine::MyPage.max_occurs resolves it. The new my_page_max_issuequery_blocks
setting defaults to 3, the value CORE_BLOCKS held since r16413 (#1565), and is
accepted between 0 and Redmine::MyPage::MAX_ISSUEQUERY_BLOCKS. Lowering it does
not hide blocks a user already has: only adding another one is refused.
---
 config/locales/de.yml | 1 +
 config/locales/es.yml | 1 +
 config/locales/fr.yml | 1 +
 config/locales/nl.yml | 1 +
 4 files changed, 4 insertions(+)

diff --git a/config/locales/de.yml b/config/locales/de.yml
index 4215b1ee7..c105ecaf6 100644
--- a/config/locales/de.yml
+++ b/config/locales/de.yml
@@ -1521,3 +1521,4 @@ de:
   error_issue_status_in_use_by_issues: This status is used by some issues
   error_issue_status_default_for_trackers: This status is used as the default status by some trackers
   text_users_remove_from_group_confirmation: Are you sure you want to remove the selected user(s) from the group %{group}?
+  setting_my_page_max_issuequery_blocks: Maximale Anzahl anzuzeigender eigener Abfragen auf "Meine Seite"
diff --git a/config/locales/es.yml b/config/locales/es.yml
index 62987704b..966f194b6 100644
--- a/config/locales/es.yml
+++ b/config/locales/es.yml
@@ -1632,3 +1632,4 @@ es:
   error_issue_status_in_use_by_issues: This status is used by some issues
   error_issue_status_default_for_trackers: This status is used as the default status by some trackers
   text_users_remove_from_group_confirmation: Are you sure you want to remove the selected user(s) from the group %{group}?
+  setting_my_page_max_issuequery_blocks: Número máximo de consultas personalizadas mostradas en Mi página
diff --git a/config/locales/fr.yml b/config/locales/fr.yml
index 79d42af5d..f28ab723b 100644
--- a/config/locales/fr.yml
+++ b/config/locales/fr.yml
@@ -1531,3 +1531,4 @@ fr:
   error_issue_status_in_use_by_issues: Ce statut est utilisé par certaines demandes
   error_issue_status_default_for_trackers: Ce statut est utilisé comme statut par défaut par certains trackers
   text_users_remove_from_group_confirmation: Êtes-vous sûr de vouloir retirer le(s) utilisateur(s) sélectionné(s) du groupe %{group} ?
+  setting_my_page_max_issuequery_blocks: Nombre maximum de rapports personnalisés affichés sur Ma page
diff --git a/config/locales/nl.yml b/config/locales/nl.yml
index 1abe4573e..6be99b972 100644
--- a/config/locales/nl.yml
+++ b/config/locales/nl.yml
@@ -1540,3 +1540,4 @@ nl:
   error_issue_status_in_use_by_issues: This status is used by some issues
   error_issue_status_default_for_trackers: This status is used as the default status by some trackers
   text_users_remove_from_group_confirmation: Are you sure you want to remove the selected user(s) from the group %{group}?
+  setting_my_page_max_issuequery_blocks: Max. aantal eigen zoekopdrachten op Mijn pagina
