From a9ec91a73185aa4d944874d48e6da385f6ad046d Mon Sep 17 00:00:00 2001
From: Jan Catrysse <jan.catrysse@geoxyz.eu>
Date: Tue, 20 Oct 2026 07:45:04 +0000
Subject: [PATCH] Fix PDF export failing with "can't dump hash with default
 proc" when a table is rendered.

RBPDF starts a transaction for a table header and deep-copies the PDF
object with Marshal. The copy included the attachments given to
RDMwriteFormattedCell and, through them, the container and its loaded
users, whose cached roles are hashes with a default proc.
---
 lib/redmine/export/pdf/itcpdf.rb         | 12 ++++++++
 test/unit/lib/redmine/export/pdf_test.rb | 35 ++++++++++++++++++++++++
 2 files changed, 47 insertions(+)

diff --git a/lib/redmine/export/pdf/itcpdf.rb b/lib/redmine/export/pdf/itcpdf.rb
index d7877f2d4..49eed8d82 100644
--- a/lib/redmine/export/pdf/itcpdf.rb
+++ b/lib/redmine/export/pdf/itcpdf.rb
@@ -102,6 +102,18 @@ module Redmine
           RDMwriteFormattedCell(w, h, x, y, txt, attachments, border, ln, fill)
         end
 
+        # The copy made by startTransaction shares the attachments instead of
+        # marshaling them, because records can hold hashes with a default proc
+        def objclone(object)
+          attachments = object.instance_variable_get(:@attachments)
+          object.instance_variable_set(:@attachments, nil)
+          copy = super
+          copy.instance_variable_set(:@attachments, attachments)
+          copy
+        ensure
+          object.instance_variable_set(:@attachments, attachments)
+        end
+
         def get_image_filename(attrname)
           atta = RDMPdfEncoding.attach(@attachments, attrname, "UTF-8")
           if atta
diff --git a/test/unit/lib/redmine/export/pdf_test.rb b/test/unit/lib/redmine/export/pdf_test.rb
index 0a95be4bc..2e94d6823 100644
--- a/test/unit/lib/redmine/export/pdf_test.rb
+++ b/test/unit/lib/redmine/export/pdf_test.rb
@@ -99,4 +99,39 @@ class PdfTest < ActiveSupport::TestCase
   ensure
     set_tmp_attachments_directory
   end
+
+  def test_write_formatted_cell_with_table_should_not_marshal_attachments
+    set_fixtures_attachments_directory
+    User.current = User.find(1)
+    issue = Issue.find(14)
+    # Caches the roles in a Hash with a default proc, which Marshal cannot dump
+    issue.author.roles_for_project(issue.project)
+    html = '<table><thead><tr><th>Name</th></tr></thead><tbody><tr><td>Value</td></tr></tbody></table>' \
+           '<img src="testfile.png" />'
+
+    pdf = Redmine::Export::PDF::ITCPDF.new('en')
+    pdf.add_page
+    pdf.RDMwriteFormattedCell(190, 5, '', '', html, issue.attachments)
+    assert_include '/Subtype /Image', pdf.output
+  ensure
+    set_tmp_attachments_directory
+  end
+
+  def test_write_formatted_cell_with_table_across_page_break_should_keep_attachments
+    set_fixtures_attachments_directory
+    User.current = User.find(1)
+    issue = Issue.find(14)
+    issue.author.roles_for_project(issue.project)
+    html = '<table><thead><tr><th>Name</th></tr></thead><tbody><tr><td>Value</td></tr></tbody></table>' \
+           '<img src="testfile.png" />'
+
+    pdf = Redmine::Export::PDF::ITCPDF.new('en')
+    pdf.add_page
+    pdf.set_y(270)
+    pdf.RDMwriteFormattedCell(190, 5, '', '', html, issue.attachments)
+    assert_equal 2, pdf.get_page
+    assert_include '/Subtype /Image', pdf.output
+  ensure
+    set_tmp_attachments_directory
+  end
 end
